{
  "id": "./",
  "name": "FBikeTrain",
  "short_name": "FBikeTrain",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#14221F",
  "background_color": "#14221F",
  "icons": [
    { "src": "brand-mark-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "brand-mark-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "files", "accept": [".gpx", ".tcx", ".fit", "application/gpx+xml", "application/vnd.garmin.tcx+xml", "application/vnd.ant.fit", "application/octet-stream"] }]
    }
  }
}
